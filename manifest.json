{
  "manifest_version": 3,
  "name": "Resubir Armario",
  "version": "1.0",
  "description": "Herramienta no oficial para resubir tus artículos de Vinted: vuelve a publicar el anuncio con las mismas fotos y datos.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.vinted.es/*",
    "https://www.vinted.fr/*",
    "https://www.vinted.it/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.de/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.com/*",
    "https://images1.vinted.net/*",
    "https://*.vinted.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.es/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.it/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.de/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resubir Armario"
  }
}
